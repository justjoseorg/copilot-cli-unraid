#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ "${#1}" -ne 32 ]; then
    echo "Select a terminal from the sidebar." >&2
    exit 1
fi
case "$1" in
    *[!a-f0-9]*) exit 1 ;;
esac
session="copilot-$1"
actual=$(tmux -S /run/copilot/tmux.sock display-message -p -t "${session}" '#{session_name}')
[ "${actual}" = "${session}" ] || exit 1
exec tmux -S /run/copilot/tmux.sock attach-session -t "${session}"
